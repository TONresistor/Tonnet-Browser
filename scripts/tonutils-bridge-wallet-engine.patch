+func TestWalletPreparationSharesVerifiedReadsAndRunsIndependentReadsConcurrently(t *testing.T) {
+	mock := newPreparationMock()
+	mock.started, mock.release = make(chan string, 3), make(chan struct{})
+	done := make(chan *walletEmulationState, 1)
+	failure := make(chan error, 1)
+	addr := address.NewAddress(0, 0, make([]byte, 32))
+	go func() {
+		state, err := prepareWalletEmulation(context.Background(), mock, addr)
+		done <- state
+		failure <- err
+	}()
+	seen := map[string]bool{}
+	for len(seen) < 3 {
+		select {
+		case name := <-mock.started:
+			seen[name] = true
+		case <-time.After(3 * time.Second):
+			close(mock.release)
+			t.Fatal("account, clock and configuration reads did not start concurrently")
+		}
+	}
+	close(mock.release)
+	state := <-done
+	if err := <-failure; err != nil {
+		t.Fatal(err)
+	}
+	if state.account != mock.account || state.master != mock.master || state.config == nil || state.now != 1001 {
+		t.Fatal("emulation must reuse the exact verified account, configuration and time")
+	}
+	if len(mock.reads) != 3 || mock.clockReads.Load() != 1 || mock.configReads.Load() != 1 {
+		t.Fatal("preparation repeated a network read")
+	}
+	client := &wsClient{}
+	id, err := client.keepWalletEmulation(state)
+	if err != nil {
+		t.Fatal(err)
+	}
+	reused, err := client.takeWalletEmulation(id, addr)
+	if err != nil || reused != state {
+		t.Fatal("prepared state was not preserved")
+	}
+	if len(mock.reads) != 3 {
+		t.Fatal("consuming prepared state fetched the account again")
+	}
