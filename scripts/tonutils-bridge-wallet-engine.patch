+func TestWalletConfirmationReceiptPreservesOriginalCellsAndObservedAccount(t *testing.T) {
+	addr := address.NewAddress(0, 0, make([]byte, 32))
+	body := cell.BeginCell().MustStoreUInt(0x1234, 16).EndCell()
+	tx := &tlb.Transaction{AccountAddr: addr.Data(), LT: 100, PrevTxHash: make([]byte, 32), PrevTxLT: 1, OrigStatus: tlb.AccountStatusActive, EndStatus: tlb.AccountStatusActive, StateUpdate: tlb.HashUpdate{OldHash: make([]byte, 32), NewHash: make([]byte, 32)}, Description: tlb.TransactionDescriptionOrdinary{ComputePhase: tlb.ComputePhase{Phase: tlb.ComputePhaseSkipped{Reason: tlb.ComputeSkipReason{Type: tlb.ComputeSkipReasonNoGas}}}}}
+	tx.IO.In = &tlb.Message{MsgType: tlb.MsgTypeExternalIn, Msg: &tlb.ExternalMessage{DstAddr: addr, Body: body}}
+	raw, err := tlb.ToCell(tx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	account := &tlb.Account{LastTxLT: 100, LastTxHash: raw.Hash(), Code: cell.BeginCell().EndCell(), Data: body, State: &tlb.AccountState{IsValid: true, AccountStorage: tlb.AccountStorage{Status: tlb.AccountStatusActive}}}
+	api := &receiptAPI{account: account, client: &receiptClient{raw: raw.ToBOCWithOptions(cell.BOCSerializeOptions{})}}
+	bridge := testBridge()
+	bridge.api = api
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	confirmed, err := bridge.waitForExternalMessage(ctx, &tlb.ExternalMessage{DstAddr: addr, Body: body}, &ton.BlockIDExt{SeqNo: 41}, &tlb.Account{LastTxLT: 1, LastTxHash: make([]byte, 32)}, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if confirmed.receipt == nil || api.client.calls != 1 {
+		t.Fatal("confirmation did not reuse the original verified read")
+	}
+	observed := confirmed.receipt["account"].(map[string]any)
+	records := confirmed.receipt["transactions"].([]map[string]any)
+	if observed["last_tx_hash"] != hex.EncodeToString(raw.Hash()) || observed["data_boc"] != base64.StdEncoding.EncodeToString(body.ToBOCWithOptions(cell.BOCSerializeOptions{})) {
+		t.Fatal("receipt changed the observed account")
+	}
+	encoded, err := base64.StdEncoding.DecodeString(records[0]["boc"].(string))
+	if err != nil {
+		t.Fatal(err)
+	}
+	original, err := cell.FromBOC(encoded)
+	if err != nil || !bytes.Equal(original.Hash(), raw.Hash()) {
+		t.Fatal("receipt reserialized the transaction")
+	}
+	if walletConfirmationReceipt(addr, account, confirmed.block, make([]map[string]any, 101)) != nil {
+		t.Fatal("unbounded confirmation receipt")
+	}
+}
