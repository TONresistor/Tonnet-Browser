+type receiptClient struct {
+	ton.LiteClient
+	raw   []byte
+	calls int
+}
+
+func (c *receiptClient) QueryLiteserver(_ context.Context, request tl.Serializable, result tl.Serializable) error {
+	if _, ok := request.(ton.GetTransactions); !ok {
+		return fmt.Errorf("unexpected receipt query %T", request)
+	}
+	c.calls++
+	*(result.(*tl.Serializable)) = ton.TransactionList{Transactions: c.raw}
+	return nil
+}
