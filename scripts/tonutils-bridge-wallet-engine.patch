new file mode 100644
index 0000000..d2b3098
--- /dev/null
+++ b/wsbridge/wallet_snapshot_test.go
@@ -0,0 +1,137 @@
+package wsbridge
+
+import (
+	"bytes"
+	"context"
+	"encoding/base64"
+	"errors"
+	"github.com/xssnick/tonutils-go/address"
+	"github.com/xssnick/tonutils-go/tlb"
+	"github.com/xssnick/tonutils-go/ton"
+	"github.com/xssnick/tonutils-go/tvm/cell"
+	"math/big"
+	"testing"
+)
+
+type snapshotNodeKey struct{}
+
+type snapshotClient struct{ ton.LiteClient }
+
+func (snapshotClient) StickyContext(ctx context.Context) context.Context {
+	return context.WithValue(ctx, snapshotNodeKey{}, true)
+}
+
+type snapshotMock struct {
+	ton.APIClientWrapped
+	waited        uint32
+	master, shard *ton.BlockIDExt
+	account       *tlb.Account
+	reads         []*ton.BlockIDExt
+	fail          bool
+}
+
+func (m *snapshotMock) Client() ton.LiteClient                         { return snapshotClient{} }
+func (m *snapshotMock) WaitForBlock(seqno uint32) ton.APIClientWrapped { m.waited = seqno; return m }
+func (m *snapshotMock) CurrentMasterchainInfo(ctx context.Context) (*ton.BlockIDExt, error) {
+	if ctx.Value(snapshotNodeKey{}) != true {
+		return nil, errors.New("node context was not pinned")
+	}
+	return m.master, nil
+}
+func (m *snapshotMock) GetBlockShardsInfo(context.Context, *ton.BlockIDExt) ([]*ton.BlockIDExt, error) {
+	if m.waited != m.master.SeqNo {
+		return nil, errors.New("code 651: master block not available")
+	}
+	return []*ton.BlockIDExt{m.shard}, nil
+}
+func (m *snapshotMock) GetBlockHeader(_ context.Context, b *ton.BlockIDExt) (*tlb.BlockHeader, error) {
+	m.reads = append(m.reads, b)
+	header := &tlb.BlockHeader{}
+	header.GenUtime = 1000
+	return header, nil
+}
+func (m *snapshotMock) GetAccount(_ context.Context, b *ton.BlockIDExt, _ *address.Address) (*tlb.Account, error) {
+	if m.waited != m.master.SeqNo || b != m.master {
+		return nil, errors.New("code 651: account block not available")
+	}
+	m.reads = append(m.reads, b)
+	return m.account, nil
+}
+func (m *snapshotMock) RunGetMethod(_ context.Context, b *ton.BlockIDExt, _ *address.Address, _ string, _ ...any) (*ton.ExecutionResult, error) {
+	if m.waited != m.master.SeqNo || b != m.master {
+		return nil, errors.New("code 651: getter block not available")
+	}
+	m.reads = append(m.reads, b)
+	if m.fail {
+		return nil, errors.New("seqno unavailable")
+	}
+	return ton.NewExecutionResult([]any{big.NewInt(7)}), nil
+}
+func TestWalletSnapshotWaitsForMasterAndPinsAccountAndSeqno(t *testing.T) {
+	mock := &snapshotMock{master: &ton.BlockIDExt{Workchain: -1, SeqNo: 42}, shard: &ton.BlockIDExt{Workchain: 0, Shard: -9223372036854775808, SeqNo: 8}, account: &tlb.Account{State: &tlb.AccountState{IsValid: true, AccountStorage: tlb.AccountStorage{Status: tlb.AccountStatusActive, Balance: tlb.FromNanoTONU(123)}}}}
+	addr := address.NewAddress(0, 0, make([]byte, 32))
+	result, err := walletSnapshot(context.Background(), mock, addr)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result["seqno"] != uint64(7) || result["balance"] != "123" || result["block_time"] != uint32(1000) {
+		t.Fatalf("unexpected snapshot: %v", result)
+	}
+	if len(mock.reads) != 3 || mock.reads[0] != mock.master || mock.reads[1] != mock.shard || mock.reads[2] != mock.master {
+		t.Fatal("account and getter must use the same master anchor; timestamp must use its shard")
+	}
+	mock.fail = true
+	if _, err = walletSnapshot(context.Background(), mock, addr); err == nil {
+		t.Fatal("getter failure must not become seqno zero")
+	}
+	mock.account = &tlb.Account{}
+	result, err = walletSnapshot(context.Background(), mock, addr)
+	if err != nil || result["seqno"] != uint64(0) || result["status"] != "uninit" {
+		t.Fatalf("invalid undeployed snapshot: %v %v", result, err)
+	}
+}
+
+func TestRawTransactionRecordsPreserveEvidenceAndRejectForeignChains(t *testing.T) {
+	addr := address.NewAddress(0, 0, make([]byte, 32))
+	tx := &tlb.Transaction{AccountAddr: addr.Data(), LT: 100, PrevTxHash: make([]byte, 32), OrigStatus: tlb.AccountStatusActive, EndStatus: tlb.AccountStatusActive, StateUpdate: tlb.HashUpdate{OldHash: make([]byte, 32), NewHash: make([]byte, 32)}, Description: tlb.TransactionDescriptionOrdinary{ComputePhase: tlb.ComputePhase{Phase: tlb.ComputePhaseSkipped{Reason: tlb.ComputeSkipReason{Type: tlb.ComputeSkipReasonNoGas}}}}}
+	raw, err := tlb.ToCell(tx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	records, err := rawTransactionRecords([]*cell.Cell{raw}, addr, 100, raw.Hash())
+	if err != nil {
+		t.Fatal(err)
+	}
+	encoded, err := base64.StdEncoding.DecodeString(records[0]["boc"].(string))
+	if err != nil {
+		t.Fatal(err)
+	}
+	preserved, err := cell.FromBOC(encoded)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(preserved.Hash(), raw.Hash()) {
+		t.Fatal("transaction cell hash changed")
+	}
+	if _, err = rawTransactionRecords([]*cell.Cell{raw}, addr, 100, make([]byte, 32)); err == nil {
+		t.Fatal("accepted wrong hash")
+	}
+	if _, err = rawTransactionRecords([]*cell.Cell{raw}, addr, 101, raw.Hash()); err == nil {
+		t.Fatal("accepted wrong logical time")
+	}
+	foreign := address.NewAddress(0, 0, bytes.Repeat([]byte{1}, 32))
+	if _, err = rawTransactionRecords([]*cell.Cell{raw}, foreign, 100, raw.Hash()); err == nil {
+		t.Fatal("accepted foreign wallet evidence")
+	}
+}
+
+func TestWalletReadContextWaitsOnTheSelectedNode(t *testing.T) {
+	mock := &snapshotMock{master: &ton.BlockIDExt{Workchain: -1, SeqNo: 42}}
+	ctx, block, reader, err := walletReadContext(context.Background(), mock)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if ctx.Value(snapshotNodeKey{}) != true || block != mock.master || reader != mock || mock.waited != 42 {
+		t.Fatal("account and emulation readers must pin a node and wait for the selected master block")
+	}
+}
