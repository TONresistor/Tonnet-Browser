+func TestRawTransactionRecordsPreserveEvidenceAndRejectForeignChains(t *testing.T) {
+	addr := address.NewAddress(0, 0, make([]byte, 32))
+	tx := &tlb.Transaction{AccountAddr: addr.Data(), LT: 100, PrevTxHash: make([]byte, 32), OrigStatus: tlb.AccountStatusActive, EndStatus: tlb.AccountStatusActive, StateUpdate: tlb.HashUpdate{OldHash: make([]byte, 32), NewHash: make([]byte, 32)}, Description: tlb.TransactionDescriptionOrdinary{ComputePhase: tlb.ComputePhase{Phase: tlb.ComputePhaseSkipped{Reason: tlb.ComputeSkipReason{Type: tlb.ComputeSkipReasonNoGas}}}}}
