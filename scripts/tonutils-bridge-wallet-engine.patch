+type receiptAPI struct {
+	ton.APIClientWrapped
+	account *tlb.Account
+	client  *receiptClient
+}
+
+func (a *receiptAPI) Client() ton.LiteClient                   { return a.client }
+func (a *receiptAPI) WaitForBlock(uint32) ton.APIClientWrapped { return a }
