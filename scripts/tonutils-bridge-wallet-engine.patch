diff --git a/wsbridge/wallet_snapshot.go b/wsbridge/wallet_snapshot.go
new file mode 100644
index 0000000..5aab545
--- /dev/null
+++ b/wsbridge/wallet_snapshot.go
@@ -0,0 +1,367 @@
+package wsbridge
+
+import (
+	"bytes"
+	"context"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"math/big"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/xssnick/tonutils-go/address"
+	"github.com/xssnick/tonutils-go/tl"
+	"github.com/xssnick/tonutils-go/tlb"
+	"github.com/xssnick/tonutils-go/ton"
+	"github.com/xssnick/tonutils-go/tvm/cell"
+)
+
+// walletSnapshotAPI anchors account and getter reads to one masterchain block.
+type walletSnapshotAPI interface {
+	Client() ton.LiteClient
+	WaitForBlock(uint32) ton.APIClientWrapped
+	CurrentMasterchainInfo(context.Context) (*ton.BlockIDExt, error)
+	GetBlockShardsInfo(context.Context, *ton.BlockIDExt) ([]*ton.BlockIDExt, error)
+	GetBlockHeader(context.Context, *ton.BlockIDExt) (*tlb.BlockHeader, error)
+	GetAccount(context.Context, *ton.BlockIDExt, *address.Address) (*tlb.Account, error)
+	RunGetMethod(context.Context, *ton.BlockIDExt, *address.Address, string, ...any) (*ton.ExecutionResult, error)
+}
+
+type walletMasterAPI interface {
+	Client() ton.LiteClient
+	CurrentMasterchainInfo(context.Context) (*ton.BlockIDExt, error)
+	WaitForBlock(uint32) ton.APIClientWrapped
+}
+
+func walletReadContext(ctx context.Context, api walletMasterAPI) (context.Context, *ton.BlockIDExt, ton.APIClientWrapped, error) {
+	ctx = api.Client().StickyContext(ctx)
+	master, err := api.CurrentMasterchainInfo(ctx)
+	if err != nil {
+		return ctx, nil, nil, err
+	}
+	return ctx, master, api.WaitForBlock(master.SeqNo), nil
+}
+
+func walletSnapshot(ctx context.Context, api walletSnapshotAPI, addr *address.Address) (map[string]any, error) {
+	ctx, master, reader, err := walletReadContext(ctx, api)
+	if err != nil {
+		return nil, err
+	}
+	state, err := walletSnapshotAt(ctx, reader, addr, master)
+	if err != nil {
+		return nil, err
+	}
+	return state.snapshot, nil
+}
+
+type walletEmulationState struct {
+	nodeContext context.Context
+	address     *address.Address
+	master      *ton.BlockIDExt
+	account     *tlb.Account
+	config      *tlb.BlockchainConfig
+	now         uint32
+	snapshot    map[string]any
+	created     time.Time
+}
+
+func walletSnapshotHeader(ctx context.Context, api walletSnapshotAPI, addr *address.Address, master *ton.BlockIDExt) (*ton.BlockIDExt, *tlb.BlockHeader, error) {
+	block := master
+	if addr.Workchain() != -1 {
+		shards, err := api.GetBlockShardsInfo(ctx, master)
+		if err != nil {
+			return nil, nil, err
+		}
+		block = nil
+		for _, shard := range shards {
+			if shard.Workchain == addr.Workchain() && tlb.ShardID(uint64(shard.Shard)).ContainsAddress(addr) {
+				block = shard
+				break
+			}
+		}
+		if block == nil {
+			return nil, nil, fmt.Errorf("account shard unavailable")
+		}
+	}
+	header, err := api.GetBlockHeader(ctx, block)
+	if err != nil {
+		return nil, nil, err
+	}
+	return block, header, nil
+}
+
+func walletSnapshotAt(ctx context.Context, api walletSnapshotAPI, addr *address.Address, master *ton.BlockIDExt) (*walletEmulationState, error) {
+	ctx, cancel := context.WithCancel(ctx)
+	var block *ton.BlockIDExt
+	var header *tlb.BlockHeader
+	var headerErr error
+	headerDone := make(chan struct{})
+	go func() {
+		defer close(headerDone)
+		block, header, headerErr = walletSnapshotHeader(ctx, api, addr, master)
+	}()
+	defer func() { cancel(); <-headerDone }()
+	account, err := api.GetAccount(ctx, master, addr)
+	if err != nil {
+		return nil, err
+	}
+	if account == nil {
+		return nil, fmt.Errorf("incomplete wallet snapshot")
+	}
+	var seqno uint64
+	if account.State != nil && account.State.IsValid && account.State.Status == tlb.AccountStatusActive {
+		value, err := api.RunGetMethod(ctx, master, addr, "seqno")
+		if err != nil {
+			return nil, err
+		}
+		values := value.AsTuple()
+		if len(values) != 1 {
+			return nil, fmt.Errorf("invalid wallet seqno stack")
+		}
+		n, ok := values[0].(*big.Int)
+		if !ok || !n.IsUint64() || n.BitLen() > 32 {
+			return nil, fmt.Errorf("invalid wallet seqno")
+		}
+		seqno = n.Uint64()
+	}
+	<-headerDone
+	if headerErr != nil {
+		return nil, headerErr
+	}
+	if header == nil {
+		return nil, fmt.Errorf("incomplete wallet snapshot")
+	}
+	result := map[string]any{
+		"address": addr.String(), "status": "uninit", "balance": "0", "seqno": seqno,
+		"last_tx_lt": fmt.Sprint(account.LastTxLT), "last_tx_hash": hex.EncodeToString(account.LastTxHash),
+		"block": snapshotBlockID(block), "masterchain": snapshotBlockID(master), "block_time": header.GenUtime,
+	}
+	if account.State != nil && account.State.IsValid {
+		result["balance"] = account.State.Balance.Nano().String()
+		if account.State.Status == tlb.AccountStatusFrozen {
+			result["status"] = "frozen"
+		}
+		if account.State.Status == tlb.AccountStatusActive {
+			result["status"] = "active"
+		}
+	}
+	if account.Code != nil {
+		result["code_hash"] = hex.EncodeToString(account.Code.Hash())
+	}
+	if account.Data != nil {
+		result["data_boc"] = base64.StdEncoding.EncodeToString(account.Data.ToBOCWithOptions(cell.BOCSerializeOptions{}))
+	}
+	return &walletEmulationState{address: addr, master: master, account: account, snapshot: result, created: time.Now()}, nil
+}
+
+func prepareWalletEmulation(ctx context.Context, api ton.APIClientWrapped, addr *address.Address) (*walletEmulationState, error) {
+	ctx, master, reader, err := walletReadContext(ctx, api)
+	if err != nil {
+		return nil, err
+	}
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	var state *walletEmulationState
+	var config *tlb.BlockchainConfig
+	var now uint32
+	var group sync.WaitGroup
+	failures := make(chan error, 3)
+	run := func(fn func() error) {
+		group.Add(1)
+		go func() {
+			defer group.Done()
+			if err := fn(); err != nil {
+				failures <- err
+				cancel()
+			}
+		}()
+	}
+	run(func() error { var err error; state, err = walletSnapshotAt(ctx, reader, addr, master); return err })
+	run(func() error { var err error; config, err = reader.GetBlockchainConfig(ctx, master); return err })
+	run(func() error { var err error; now, err = reader.GetTime(ctx); return err })
+	group.Wait()
+	close(failures)
+	if err := <-failures; err != nil {
+		return nil, err
+	}
+	if config == nil {
+		return nil, fmt.Errorf("blockchain configuration unavailable")
+	}
+	state.config, state.now = config, now
+	state.nodeContext = context.WithoutCancel(ctx)
+	return state, nil
+}
+
+type walletNodeContext struct {
+	context.Context
+	values context.Context
+}
+
+func (ctx walletNodeContext) Value(key any) any {
+	if value := ctx.values.Value(key); value != nil {
+		return value
+	}
+	return ctx.Context.Value(key)
+}
+
+const walletEmulationLifetime = 30 * time.Second
+const walletEmulationLimit = 4
+
+func (client *wsClient) keepWalletEmulation(state *walletEmulationState) (string, error) {
+	client.walletEmulationMu.Lock()
+	defer client.walletEmulationMu.Unlock()
+	if client.walletEmulations == nil {
+		client.walletEmulations = make(map[string]*walletEmulationState)
+	}
+	for id, pending := range client.walletEmulations {
+		if time.Since(pending.created) > walletEmulationLifetime {
+			delete(client.walletEmulations, id)
+		}
+	}
+	if len(client.walletEmulations) >= walletEmulationLimit {
+		return "", fmt.Errorf("too many prepared wallet emulations")
+	}
+	id := fmt.Sprintf("wallet_%d", atomic.AddUint64(&client.subCounter, 1))
+	client.walletEmulations[id] = state
+	return id, nil
+}
+
+func (client *wsClient) takeWalletEmulation(id string, addr *address.Address) (*walletEmulationState, error) {
+	client.walletEmulationMu.Lock()
+	defer client.walletEmulationMu.Unlock()
+	state := client.walletEmulations[id]
+	delete(client.walletEmulations, id)
+	if state == nil || time.Since(state.created) > walletEmulationLifetime || !state.address.Equals(addr) {
+		return nil, fmt.Errorf("wallet emulation context unavailable")
+	}
+	return state, nil
+}
+
+func revalidateWalletEmulation(ctx context.Context, api ton.APIClientWrapped, state *walletEmulationState) (map[string]any, error) {
+	if state.nodeContext != nil {
+		ctx = walletNodeContext{Context: ctx, values: state.nodeContext}
+	} else {
+		ctx = api.Client().StickyContext(ctx)
+	}
+	master, err := api.WaitForBlock(state.master.SeqNo).GetMasterchainInfo(ctx)
+	if err != nil {
+		return nil, err
+	}
+	if master.SeqNo < state.master.SeqNo {
+		return nil, fmt.Errorf("wallet masterchain state regressed")
+	}
+	if master.SeqNo == state.master.SeqNo {
+		if master.Workchain != state.master.Workchain || master.Shard != state.master.Shard || !bytes.Equal(master.RootHash, state.master.RootHash) || !bytes.Equal(master.FileHash, state.master.FileHash) {
+			return nil, fmt.Errorf("wallet masterchain reference changed")
+		}
+		return state.snapshot, nil
+	}
+	fresh, err := walletSnapshotAt(ctx, api.WaitForBlock(master.SeqNo), state.address, master)
+	if err != nil {
+		return nil, err
+	}
+	return fresh.snapshot, nil
+}
+
+func snapshotBlockID(block *ton.BlockIDExt) map[string]any {
+	return map[string]any{"workchain": block.Workchain, "shard": fmt.Sprintf("%016x", uint64(block.Shard)), "seqno": block.SeqNo, "root_hash": hex.EncodeToString(block.RootHash), "file_hash": hex.EncodeToString(block.FileHash)}
+}
+
+func (b *WSBridge) handleWalletGetSnapshot(client *wsClient, req *WSRequest) {
+	var params struct {
+		Address          string `json:"address"`
+		PrepareEmulation bool   `json:"prepare_emulation"`
+	}
+	if err := json.Unmarshal(req.Params, &params); err != nil {
+		b.sendError(client, req.ID, "invalid params", -32602)
+		return
+	}
+	addr, err := parseAddress(params.Address)
+	if err != nil {
+		b.sendError(client, req.ID, "invalid address", -32602)
+		return
+	}
+	ctx, cancel := context.WithTimeout(client.ctx, b.cfg.Namespaces.Wallet.Timeout)
+	defer cancel()
+	var result map[string]any
+	if params.PrepareEmulation {
+		var state *walletEmulationState
+		state, err = prepareWalletEmulation(ctx, b.api, addr)
+		if err == nil {
+			var id string
+			id, err = client.keepWalletEmulation(state)
+			if err == nil {
+				result = make(map[string]any, len(state.snapshot)+1)
+				for key, value := range state.snapshot {
+					result[key] = value
+				}
+				result["emulation_context"] = id
+			}
+		}
+	} else {
+		result, err = walletSnapshot(ctx, b.api, addr)
+	}
+	if err != nil {
+		b.sendError(client, req.ID, "wallet snapshot failed: "+err.Error())
+		return
+	}
+	b.sendResult(client, req.ID, result)
+}
+
+// Preserve the original network cells: reserialization may change a valid dictionary encoding and its hash.
+func rawTransactionRecords(cells []*cell.Cell, addr *address.Address, expectedLT uint64, expectedHash []byte) ([]map[string]any, error) {
+	records := make([]map[string]any, 0, len(cells))
+	for _, raw := range cells {
+		if !bytes.Equal(raw.Hash(), expectedHash) {
+			return nil, fmt.Errorf("transaction hash mismatch")
+		}
+		var tx tlb.Transaction
+		if err := tlb.Parse(&tx, raw); err != nil {
+			return nil, err
+		}
+		if tx.LT != expectedLT || !bytes.Equal(tx.AccountAddr, addr.Data()) || (tx.PrevTxLT != 0 && tx.PrevTxLT >= tx.LT) {
+			return nil, fmt.Errorf("transaction chain mismatch")
+		}
+		tx.Hash = raw.Hash()
+		record := serializeTransaction(&tx)
+		record["boc"] = base64.StdEncoding.EncodeToString(raw.ToBOCWithOptions(cell.BOCSerializeOptions{}))
+		records = append(records, record)
+		expectedLT = tx.PrevTxLT
+		expectedHash = tx.PrevTxHash
+	}
+	return records, nil
+}
+
+func readWalletTransactionRecords(ctx context.Context, api ton.APIClientWrapped, addr *address.Address, limit uint32, lt uint64, hash []byte) ([]map[string]any, error) {
+	var response tl.Serializable
+	if err := api.Client().QueryLiteserver(ctx, ton.GetTransactions{Limit: int32(limit), AccID: &ton.AccountID{Workchain: addr.Workchain(), ID: addr.Data()}, LT: int64(lt), TxHash: hash}, &response); err != nil {
+		return nil, err
+	}
+	list, ok := response.(ton.TransactionList)
+	if !ok {
+		return nil, fmt.Errorf("raw transaction history unavailable")
+	}
+	cells, err := cell.FromBOCMultiRoot(list.Transactions)
+	if err != nil || len(cells) > int(limit) {
+		return nil, fmt.Errorf("invalid raw transaction page")
+	}
+	return rawTransactionRecords(cells, addr, lt, hash)
+}
+
+func walletConfirmationReceipt(addr *address.Address, account *tlb.Account, master *ton.BlockIDExt, records []map[string]any) map[string]any {
+	if account == nil || account.State == nil || !account.State.IsValid || account.State.Status != tlb.AccountStatusActive || account.Code == nil || account.Data == nil || len(records) == 0 || len(records) > 100 {
+		return nil
+	}
+	return map[string]any{
+		"account": map[string]any{
+			"address": addr.String(), "status": "active",
+			"code_hash":  hex.EncodeToString(account.Code.Hash()),
+			"data_boc":   base64.StdEncoding.EncodeToString(account.Data.ToBOCWithOptions(cell.BOCSerializeOptions{})),
+			"last_tx_lt": fmt.Sprint(account.LastTxLT), "last_tx_hash": hex.EncodeToString(account.LastTxHash),
+		},
+		"masterchain": snapshotBlockID(master), "transactions": records,
+	}
+}
