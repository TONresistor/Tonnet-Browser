+	*preparationMock
+	accountStarted, headerStarted chan struct{}
+	failAccount                   bool
+}
+
+func (m *parallelSnapshotMock) WaitForBlock(seqno uint32) ton.APIClientWrapped {
+	m.waited = seqno
+	return m
+}
+func (m *parallelSnapshotMock) GetAccount(ctx context.Context, block *ton.BlockIDExt, addr *address.Address) (*tlb.Account, error) {
+	close(m.accountStarted)
+	if m.failAccount {
+		return nil, errors.New("account unavailable")
+	}
+	select {
+	case <-m.headerStarted:
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	}
+	return m.preparationMock.GetAccount(ctx, block, addr)
+}
+func (m *parallelSnapshotMock) GetBlockHeader(ctx context.Context, block *ton.BlockIDExt) (*tlb.BlockHeader, error) {
+	close(m.headerStarted)
+	if m.failAccount {
+		<-ctx.Done()
+		return nil, ctx.Err()
+	}
+	select {
+	case <-m.accountStarted:
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	}
+	return m.snapshotMock.GetBlockHeader(ctx, block)
+}
+func TestWalletSnapshotReadsAccountAndShardConcurrentlyAndDrainsOnFailure(t *testing.T) {
+	for _, fail := range []bool{false, true} {
+		t.Run(fmt.Sprint(fail), func(t *testing.T) {
+			mock := &parallelSnapshotMock{preparationMock: newPreparationMock(), accountStarted: make(chan struct{}), headerStarted: make(chan struct{}), failAccount: fail}
+			ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+			defer cancel()
+			result, err := walletSnapshot(ctx, mock, address.NewAddress(0, 0, make([]byte, 32)))
+			if fail {
+				if err == nil || err.Error() != "account unavailable" {
+					t.Fatalf("account failure changed: %v", err)
+				}
+				select {
+				case <-mock.headerStarted:
+				default:
+					t.Fatal("header read was not drained")
+				}
+			} else if err != nil || result["seqno"] != uint64(7) || result["block_time"] != uint32(1000) {
+				t.Fatalf("parallel reads lost a verified field: %v %v", result, err)
+			}
+		})
+	}
+}
