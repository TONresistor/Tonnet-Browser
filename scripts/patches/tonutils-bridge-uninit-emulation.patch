--- /dev/null
+++ b/wsbridge/tonnet_preflight_patch_test.go
@@ -0,0 +1,24 @@
+package wsbridge
+
+import (
+	"os"
+	"strings"
+	"testing"
+)
+
+func TestTonnetPreflightPatchWiring(t *testing.T) {
+	source, err := os.ReadFile("lite.go")
+	if err != nil {
+		t.Fatalf("read lite.go: %v", err)
+	}
+	text := string(source)
+	for _, required := range []string{
+		`IgnoreChkSig bool   ` + "`json:\"ignore_chksig\"`",
+		"SignatureCheckAlwaysSucceed: params.IgnoreChkSig",
+		"acc.State == nil || !acc.State.IsValid",
+	} {
+		if !strings.Contains(text, required) {
+			t.Fatalf("patched preflight wiring missing %q", required)
+		}
+	}
+}
